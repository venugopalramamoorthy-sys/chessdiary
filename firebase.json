{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/app-shell.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/landing/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/main.dart.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/flutter.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/delete-account",
        "destination": "/delete-account/index.html"
      },
      {
        "source": "/guides",
        "destination": "/guides/index.html"
      },
      {
        "source": "/guides/how-to-read-a-chess-scoresheet",
        "destination": "/guides/how-to-read-a-chess-scoresheet/index.html"
      },
      {
        "source": "/guides/common-chess-blunders",
        "destination": "/guides/common-chess-blunders/index.html"
      },
      {
        "source": "/guides/chess-opening-principles",
        "destination": "/guides/chess-opening-principles/index.html"
      },
      {
        "source": "/",
        "destination": "/landing/index.html"
      },
      {
        "source": "/app",
        "destination": "/app-shell.html"
      },
      {
        "source": "/app/**",
        "destination": "/app-shell.html"
      },
      {
        "source": "**",
        "destination": "/app-shell.html"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
